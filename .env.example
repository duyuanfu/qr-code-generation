# ===== 对外访问 =====
# 宿主机对外暴露的端口（如 3001 被占用，可改为 3002、8090 等）
APP_PORT=3001

# ===== MySQL =====
# 必填：后端用同一个 root 账号连库。生成一个强口令，别用 root。
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=qr_studio

# ===== 后端安全配置（以下三项必填，缺失时容器无法启动）=====
# JWT 签名密钥，至少 32 字节。生成：openssl rand -base64 48
JWT_SECRET=
# 首次启动时种子化的超级管理员账号
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# 一键模拟支付通道：线上必须 false（不填即 false）
MOCK_PAY_ENABLED=false

# ===== 上传 =====
# 单个文件体积上限（MB），需与后端 multipart 配置一致
UPLOAD_MAX_FILE_SIZE_MB=500

# ===== 品牌露出 =====
# 扫码落地页底部展示的品牌链接（不填则默认 http://qr.trythis.pw/）
NEXT_PUBLIC_BRAND_URL=http://qr.trythis.pw/

# ===== 不用 Docker、直接跑后端时 =====
# application.yml 的口令只从环境变量读，本地开发请改用 dev profile：
#   cd backend && mvn spring-boot:run -Dspring-boot.run.profiles=dev
# 如果需要连真实环境而不走 dev profile，则导出：
#   DB_PASSWORD / JWT_SECRET / ADMIN_PASSWORD
