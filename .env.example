# ===== 对外访问 =====
# 宿主机对外暴露的端口（如 3001 被占用，可改为 3002、8090 等）
APP_PORT=3001

# ===== 共享 MySQL（shared-mysql 容器）=====
# 本项目不再自带 MySQL：数据库由宿主机上的公共实例统一承载。
# 库名与专用账号不用等谁分配 —— 迁移脚本会用共享实例的 root 现建（见 docs/migrate-to-shared-mysql.md）。
# DB_HOST 直接写容器名，走 shared-net 内部 DNS，3306 无需暴露到公网。
DB_HOST=shared-mysql
DB_PORT=3306
DB_NAME=qr_studio
DB_USER=qr_studio_user
# 必填：本库专用账号的口令（不要用共享实例的 root 口令，那是其他业务的命脉）
DB_PASSWORD=

# 仅在【迁移那一次】需要：旧的自带 MySQL 容器信息，
# 供 scripts/migrate-to-shared-mysql.sh 导出历史数据用；迁移完成、旧卷删除后可整段删掉。
OLD_MYSQL_CONTAINER=qr-studio-mysql
MYSQL_ROOT_PASSWORD=

# ===== 后端安全配置（以下三项必填，缺失时容器无法启动）=====
# JWT 签名密钥，至少 32 字节。生成：openssl rand -base64 48
JWT_SECRET=
# 首次启动时种子化的超级管理员账号
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# 一键模拟支付通道：线上必须 false（不填即 false）
MOCK_PAY_ENABLED=false

# ===== 上传 =====
# 单个文件体积上限（MB），需与后端 multipart 配置一致
UPLOAD_MAX_FILE_SIZE_MB=500

# ===== 品牌露出 =====
# 扫码落地页底部展示的品牌链接（不填则默认 http://qr.trythis.pw/）
NEXT_PUBLIC_BRAND_URL=http://qr.trythis.pw/

# ===== 不用 Docker、直接跑后端时 =====
# application.yml 的口令只从环境变量读，本地开发请改用 dev profile：
#   cd backend && mvn spring-boot:run -Dspring-boot.run.profiles=dev
# 如果需要连真实环境而不走 dev profile，则导出：
#   DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD / JWT_SECRET / ADMIN_PASSWORD
