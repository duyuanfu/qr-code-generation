# ===== 对外访问 =====
# 宿主机对外暴露的端口（如 3001 被占用，可改为 3002、8090 等）
APP_PORT=3001

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=qr_studio

# ===== 后端安全配置（生产环境必须修改）=====
# JWT 签名密钥，长度至少 32 字节
JWT_SECRET=qr-studio-change-me-in-production-32bytes-minimum
# 首次启动时种子化的超级管理员账号
ADMIN_EMAIL=duyuanfu@yeah.net
ADMIN_PASSWORD=dyf5970@
# 一键模拟支付通道：本地开发可设 true，线上务必 false（默认 false）
MOCK_PAY_ENABLED=false

# ===== 上传 =====
# 单个文件体积上限（MB），需与后端 multipart 配置一致
UPLOAD_MAX_FILE_SIZE_MB=500

# ===== 品牌露出 =====
# 扫码落地页底部展示的品牌链接（不填则默认 http://qr.trythis.pw/）
NEXT_PUBLIC_BRAND_URL=http://qr.trythis.pw/
