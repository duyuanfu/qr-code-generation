# Nginx 反向代理配置示例（适用于服务器已有其他应用、或使用宝塔面板 / 1Panel）
# 推荐绑定一个独立二级域名，例如：qr.yourdomain.com

server {
    listen 80;
    server_name qr.yourdomain.com; # 替换为您自己的域名

    # 强制跳转 HTTPS（可选）
    # return 301 https://$host$request_uri;

    # 允许上传大文件（如高清视频与资料），建议设置为 100M 或以上
    client_max_body_size 100M;

    location / {
        # 对应 docker-compose.yml 暴露的宿主机端口（默认 3001）
        proxy_pass http://127.0.0.1:3001;
        
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # 传递真实客户端 IP，以便扫码日志准确记录地区与设备画像
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 超时时间设置（避免大文件上传时连接中断）
        proxy_connect_timeout 60s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
